# Database Connection (Supabase Transaction Pooler on port 6543 for serverless/Vercel)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Database Connection (Supabase Session Pooler on port 5432 for Prisma migrations / db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# JWT Authentication
JWT_SECRET="your-secure-random-jwt-secret-key-min-32-chars"

# Supabase API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"
